# ── StepFun API ──────────────────────────────────────────────
# 到 https://platform.stepfun.com/interface-key 获取
STEPFUN_API_KEY=YOUR_STEPFUN_API_KEY
# 订阅制通道（用套餐 Credit）：
STEPFUN_API_BASE=https://api.stepfun.com/step_plan/v1
# 按量付费通道改用：
# STEPFUN_API_BASE=https://api.stepfun.com/v1

# ── LLM（文字对话链路） ──────────────────────────────────────
# 可选：step-3.7-flash / step-3.5-flash / step-5-preview
# 实时语音场景建议 step-3.5-flash + reasoning low，首字更快
LLM_MODEL=step-3.5-flash
# 这些模型都带推理阶段，会先"想"再答。max_tokens 给小了会出现
# "思考完没预算说正文"，表现为数字人张不开嘴，所以给足余量。
LLM_MAX_TOKENS=1024
# 思考深度：low / medium / high
LLM_REASONING_EFFORT=low

# 人设。语音场景必须口语短句；Markdown/列表/emoji 会被 TTS 逐字念出来。
# 也可以在软件界面的设置面板里改（那边优先级更高）。
LLM_SYSTEM_PROMPT=你是一个数字人助手，说话口语化、自然，每次回复控制在两三句话以内，可以带语气词。绝对不要使用 Markdown、列表、编号、星号或表情符号，因为你的回复会被语音合成朗读出来。

# ── TTS ──────────────────────────────────────────────────────
# stepaudio-2.5-tts / stepaudio-3-tts / step-tts-2 / step-tts-mini
STEPFUN_TTS_MODEL=stepaudio-2.5-tts
STEPFUN_TTS_SPEED=1.0
# 语气描述，可用自然语言控制（<=200 字）
STEPFUN_TTS_INSTRUCTION=

# ── ASR（录音模式的整段识别） ────────────────────────────────
STEPFUN_ASR_MODEL=stepaudio-2.5-asr
# cloud = 走云端识别（不装 funasr）；local = 本地 SenseVoice
ASR_BACKEND=cloud

# ── 实时语音（点麦克风说话时走这条，边说边识别，延迟最低） ──
# 浏览器上行是 16k PCM，服务端会自动升采样到 24k 再发云端
STEPFUN_REALTIME_MODEL=stepaudio-2.5-realtime
STEPFUN_REALTIME_VOICE=linjiajiejie
# 静多久算"说完了"（毫秒）；调小=她抢话更积极，调大=更耐心听完
REALTIME_SILENCE_MS=600

# ── WebRTC 画面质量 ──────────────────────────────────────────
# 码率上限（bit/s）。aiortc 默认约 1Mbps，720p 会明显发虚。
# 8Mbps 足够 720p；本地局域网可调到 12000000。
WEBRTC_VIDEO_BITRATE=8000000
